<%= form_for task, html: { class: "flex flex-col w-fit gap-y-4" } do |form| %>
  <%- if task.errors.any? %>
    <ul class="list-disc pl-5 text-red-700">
      <%- task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <%- end %>
    </ul>
  <%- end %>

  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :description %>
  <%= form.text_area :description %>

  <%= form.label :assignee_id, "Assignee" %>
  <%= form.collection_select :assignee_id, assignable_users, :id, :name, include_blank: "Unassigned" %>

  <%= form.label :due_date %>
  <%= form.date_field :due_date %>

  <div class="flex justify-start items-center gap-x-2">
    <%= form.submit "Save Task", class: "p-2 border rounded bg-gray-100 hover:bg-gray-200 cursor-pointer" %>
    <%- unless task.new_record? %>
      <%= link_to "Cancel", tasks_path %>
    <%- end %>
  </div>

<% end %>
