<div class="flex gap-x-8">
  <h2 class="<%= class_names("text-lg font-semibold shrink-0", "line-through": task.complete?) %>"><%= task.title %></h2>
  <div><%= task.complete? ? "Complete" : "Incomplete" %></div>
  <div class="italic"><%= task.description&.truncate(50) %></div>
  <div><%= assignee_name(task:) %></div>
  <div><%= due_date_label(task:) %></div>
  <div class="flex gap-x-2">
    <%= button_to task.complete? ? "Mark incomplete" : "Mark complete",
          task_path(task),
          method: :patch,
          params: { task: { complete: !task.complete? } },
          class: "px-2 border rounded bg-gray-100 hover:bg-gray-200 cursor-pointer" %>
    <%= link_to "Edit", edit_task_path(task) %>
    <%= link_to "Delete", task_path(task), data: { turbo_method: "delete" } %>
  </div>
</div>
