<h1 class="text-2xl font-bold mb-4">Tasks</h1>

<section id="due-soon" class="flex flex-col gap-y-4 mb-8">
  <h2 class="text-xl font-bold">Due Soon</h2>
  <%- if @due_soon_tasks.present? %>
    <%= render partial: "task", collection: @due_soon_tasks %>
  <%- else %>
    <p class="italic">Nothing due soon.</p>
  <%- end %>
</section>

<div class="flex flex-col gap-y-8">
  <%= render partial: "task", collection: @tasks %>
</div>

<hr class="my-8" />

<%= render partial: "form", locals: { task: Task.new } %>
